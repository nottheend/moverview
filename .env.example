# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ── Docker / Registry ─────────────────────────────────────────────────────────
# Your Cloudron's built-in registry domain.
# Find it: Cloudron Admin → App Store → gear icon (top right) → Registry
CLOUDRON_REGISTRY=registry.your-cloudron.example.com
IMAGE_NAME=firefly-dashboard

# ── Cloudron app location ─────────────────────────────────────────────────────
CLOUDRON_APP=firefly-ui

# ── ntfy release notifications ───────────────────────────────────────────────
# Self-hosted ntfy on Cloudron. Leave blank to skip notifications.
# Create an access token in your ntfy UI under Settings → Access Tokens.
NTFY_URL=https://ntfy.your-cloudron.example.com
NTFY_TOPIC=moverview-releases
NTFY_TOKEN=tk_your-access-token-here

# ── Dev only ──────────────────────────────────────────────────────────────────
# start.sh overwrites (hardcodes) NODE_ENV=production in the container;
# setting below only set this locally.
# FIREFLY_BASE_URL and FIREFLY_TOKEN are set directly on the Cloudron app via
# `cloudron env set` — see README → "Setting env vars". Never put them here.
NODE_ENV=development   # overwritten to 'production' by start.sh in the container — only relevant locally
